<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MdExplorer.UI.ViewModels"
        xmlns:views="using:MdExplorer.UI.Views"
        x:Class="MdExplorer.UI.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1280" Height="840"
        MinWidth="360" MinHeight="520"
        Title="Eidoria"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="48"
        Icon="/Assets/eidoria.ico"
        Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}">
  <views:MainView />
</Window>
