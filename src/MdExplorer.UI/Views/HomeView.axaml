<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:vm="using:MdExplorer.UI.ViewModels"
             x:Class="MdExplorer.UI.Views.HomeView"
             x:DataType="vm:ShellViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,12,20,28" Spacing="22" MaxWidth="1100" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <md:MdSearchBar x:Name="HomeSearch" PlaceholderText="搜索文件（在主目录中递归）" ShowClearButton="True" />
        <TextBlock Classes="caption" Text="回车开始搜索；进入文件夹后可按名称快速过滤。" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="存储" />
        <ItemsControl ItemsSource="{Binding Volumes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VolumeItemModel">
              <Border Classes="card" Width="280" Margin="0,0,12,12" Tapped="OnVolumeTapped" Cursor="Hand">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <md:MdIcon Glyph="{Binding Glyph}" Size="24" />
                    <TextBlock Classes="h3" Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                  <md:MdLinearProgressIndicator Minimum="0" Maximum="100" Value="{Binding UsedPercent}" Height="6" />
                  <TextBlock Classes="caption" Text="{Binding UsageText}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="类别" />
        <WrapPanel Orientation="Horizontal">
          <Border Classes="tap-chip" Margin="0,0,8,8" Tag="Image" Tapped="OnCategoryTapped" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8"><md:MdIcon Glyph="{x:Static md:MdSymbols.Image}" Size="20" /><TextBlock Text="图片" VerticalAlignment="Center" /></StackPanel>
          </Border>
          <Border Classes="tap-chip" Margin="0,0,8,8" Tag="Video" Tapped="OnCategoryTapped" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8"><md:MdIcon Glyph="{x:Static md:MdSymbols.Movie}" Size="20" /><TextBlock Text="视频" VerticalAlignment="Center" /></StackPanel>
          </Border>
          <Border Classes="tap-chip" Margin="0,0,8,8" Tag="Audio" Tapped="OnCategoryTapped" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8"><md:MdIcon Glyph="{x:Static md:MdSymbols.MusicNote}" Size="20" /><TextBlock Text="音频" VerticalAlignment="Center" /></StackPanel>
          </Border>
          <Border Classes="tap-chip" Margin="0,0,8,8" Tag="Document" Tapped="OnCategoryTapped" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8"><md:MdIcon Glyph="{x:Static md:MdSymbols.Description}" Size="20" /><TextBlock Text="文档" VerticalAlignment="Center" /></StackPanel>
          </Border>
          <Border Classes="tap-chip" Margin="0,0,8,8" Tag="Archive" Tapped="OnCategoryTapped" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8"><md:MdIcon Glyph="{x:Static md:MdSymbols.FolderZip}" Size="20" /><TextBlock Text="压缩包" VerticalAlignment="Center" /></StackPanel>
          </Border>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="位置" />
        <ItemsControl ItemsSource="{Binding Places}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavEntry">
              <Border Classes="tap-chip" Margin="0,0,8,8" Tapped="OnPlaceTapped" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <md:MdIcon Glyph="{Binding Glyph}" Size="20" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="10" IsVisible="{Binding HasFavorites}">
        <TextBlock Classes="h3" Text="收藏" />
        <ItemsControl ItemsSource="{Binding FavoriteItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FileItemViewModel">
              <Border Classes="tap-chip" Margin="0,0,0,8" Tapped="OnFavoriteTapped" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <md:MdIcon Glyph="{Binding Glyph}" Size="22" Foreground="{Binding GlyphBrush}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Classes="caption" Text="{Binding ParentText}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
