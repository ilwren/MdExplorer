<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:vm="using:MdExplorer.UI.ViewModels"
             x:Class="MdExplorer.UI.Views.DrawerContentView"
             x:DataType="vm:ShellViewModel"
             Background="Transparent">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,18,14,20" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="11" Margin="8,0,0,16">
        <Border Width="46" Height="46" CornerRadius="14" ClipToBounds="True" BoxShadow="0 5 14 #22000000">
          <Image Source="avares://MdExplorer.UI/Assets/eidoria.png" Width="46" Height="46" />
        </Border>
        <StackPanel Spacing="0" VerticalAlignment="Center">
          <TextBlock Classes="h2" Text="Eidoria" />
          <TextBlock Classes="caption" Text="万象屿 · 本地文件" />
        </StackPanel>
      </StackPanel>

      <md:MdButton Variant="Outlined" Height="42" Margin="2,0,2,12" HorizontalAlignment="Left"
                   IsVisible="{Binding IsBrowser}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <md:MdIcon Glyph="{x:Static md:MdSymbols.Add}" Size="19" />
          <TextBlock Text="新建" VerticalAlignment="Center" />
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="Right">
            <Border Background="{DynamicResource Md.Sys.Color.Surface.Brush}" CornerRadius="16" Padding="6"
                    BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1">
              <StackPanel Spacing="3" MinWidth="160">
                <md:MdButton Variant="Text" Content="新建文件夹" Command="{Binding Browser.NewFolderCommand}" />
                <md:MdButton Variant="Text" Content="新建文件" Command="{Binding Browser.NewFileCommand}" />
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>
      </md:MdButton>

      <md:MdButton Classes="nav-entry" Classes.active="{Binding IsHome}" Variant="Text" Command="{Binding GoHomeCommand}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <md:MdIcon Glyph="{x:Static md:MdSymbols.Home}" Size="22" />
          <TextBlock Text="主页" FontSize="14.5" VerticalAlignment="Center" />
        </StackPanel>
      </md:MdButton>
      <md:MdButton Classes="nav-entry" Classes.active="{Binding IsFavoritesPage}" Variant="Text" Command="{Binding GoFavoritesCommand}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <md:MdIcon Glyph="{x:Static md:MdSymbols.Star}" Size="22" />
          <TextBlock Text="收藏" FontSize="14.5" VerticalAlignment="Center" />
        </StackPanel>
      </md:MdButton>

      <TextBlock Classes="caption" Text="位置" Margin="8,14,0,4" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Places}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NavEntry">
            <md:MdButton Classes="nav-entry" Variant="Text" Click="OnNavEntryClick">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <md:MdIcon Glyph="{Binding Glyph}" Size="22" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </md:MdButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="caption" Text="已授权文件夹" Margin="8,14,0,4" FontWeight="SemiBold"
                 IsVisible="{Binding Capabilities.IsAndroid}" />
      <ItemsControl ItemsSource="{Binding AuthorizedRoots}" IsVisible="{Binding Capabilities.IsAndroid}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AuthorizedRootModel">
            <md:MdButton Classes="nav-entry" Variant="Text" Click="OnAuthorizedRootClick">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <md:MdIcon Glyph="{x:Static md:MdSymbols.Folder}" Size="22" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </md:MdButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <md:MdButton Classes="nav-entry" Variant="Text" Command="{Binding PickAuthorizedFolderCommand}"
                   IsVisible="{Binding Capabilities.IsAndroid}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <md:MdIcon Glyph="{x:Static md:MdSymbols.FolderOpen}" Size="22" />
          <TextBlock Text="授权文件夹…" VerticalAlignment="Center" />
        </StackPanel>
      </md:MdButton>

      <TextBlock Classes="caption" Text="存储设备" Margin="8,14,0,4" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Volumes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:VolumeItemModel">
            <md:MdButton Classes="nav-entry" Variant="Text" Height="58" Click="OnVolumeClick"
                         HorizontalContentAlignment="Stretch" ToolTip.Tip="{Binding UsageText}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" MinWidth="168">
                <Border Width="34" Height="34" CornerRadius="10" VerticalAlignment="Center"
                        Background="{DynamicResource Md.Sys.Color.Surface.Brush}">
                  <md:MdIcon Glyph="{Binding Glyph}" Size="19" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding UsedPercentText}" />
                  </Grid>
                  <md:MdLinearProgressIndicator Minimum="0" Maximum="100" Value="{Binding UsedPercent}" Height="4" />
                </StackPanel>
              </Grid>
            </md:MdButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="caption" Text="已收藏文件夹" Margin="8,14,0,4" FontWeight="SemiBold"
                 IsVisible="{Binding HasFavorites}" />
      <ItemsControl ItemsSource="{Binding FavoriteItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FileItemViewModel">
            <md:MdButton Classes="nav-entry" Variant="Text" Click="OnFavoriteClick" IsVisible="{Binding IsFolder}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <md:MdIcon Glyph="{x:Static md:MdSymbols.Folder}" Size="22" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </md:MdButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Height="1" Margin="8,14" Background="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
      <md:MdButton Classes="nav-entry" Classes.active="{Binding IsTrashPage}" Variant="Text" Command="{Binding GoTrashCommand}"
                   IsVisible="{Binding Capabilities.CanMoveToTrash}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <md:MdIcon Glyph="{x:Static md:MdSymbols.Delete}" Size="22" />
          <TextBlock Text="回收站" VerticalAlignment="Center" />
        </StackPanel>
      </md:MdButton>
      <md:MdButton Classes="nav-entry" Classes.active="{Binding IsSettingsPage}" Variant="Text" Command="{Binding GoSettingsCommand}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <md:MdIcon Glyph="{x:Static md:MdSymbols.Settings}" Size="22" />
          <TextBlock Text="设置" VerticalAlignment="Center" />
        </StackPanel>
      </md:MdButton>
    </StackPanel>
  </ScrollViewer>
</UserControl>
