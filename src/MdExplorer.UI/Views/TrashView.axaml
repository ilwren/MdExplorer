<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:vm="using:MdExplorer.UI.ViewModels"
             x:Class="MdExplorer.UI.Views.TrashView"
             x:DataType="vm:ShellViewModel">
  <Grid Margin="20,12,20,20" RowDefinitions="Auto,*">
    <TextBlock Classes="h1" Text="回收站" />
    <Grid Grid.Row="1" Margin="0,12,0,0">
      <StackPanel IsVisible="{Binding !Capabilities.CanBrowseTrash}" VerticalAlignment="Center"
                  HorizontalAlignment="Center" Spacing="8" MaxWidth="420">
        <md:MdIcon Glyph="{x:Static md:MdSymbols.Delete}" Size="48" HorizontalAlignment="Center" />
        <TextBlock Classes="body" TextWrapping="Wrap" TextAlignment="Center"
                   Text="当前平台无法在应用内浏览回收站。移入回收站的文件请通过系统回收站（桌面）管理；Android 无系统回收站，删除会要求二次确认。" />
      </StackPanel>

      <StackPanel IsVisible="{Binding ShowTrashEmpty}" VerticalAlignment="Center"
                  HorizontalAlignment="Center" Spacing="8">
        <md:MdIcon Glyph="{x:Static md:MdSymbols.Delete}" Size="48" HorizontalAlignment="Center"
                   Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
        <TextBlock Classes="body" Text="回收站是空的" />
      </StackPanel>

      <md:MdList ItemsSource="{Binding TrashItems}" IsVisible="{Binding Capabilities.CanBrowseTrash}"
               Background="Transparent" BorderThickness="0">
        <md:MdList.ItemTemplate>
          <DataTemplate x:DataType="vm:TrashItemModel">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="4,6" ToolTip.Tip="{Binding OriginalPath}">
              <Border Width="38" Height="38" CornerRadius="11" VerticalAlignment="Center"
                      Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}">
                <md:MdIcon Glyph="{x:Static md:MdSymbols.Delete}" Size="19"
                           Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="{Binding DeletedText}" />
              </StackPanel>
              <md:MdIconButton Grid.Column="2" Icon="{x:Static md:MdSymbols.Refresh}" Click="OnRestoreClick"
                               ToolTip.Tip="还原" AutomationProperties.Name="还原" />
              <md:MdIconButton Grid.Column="3" Icon="{x:Static md:MdSymbols.Delete}" Click="OnDeleteClick"
                               Foreground="{DynamicResource Md.Sys.Color.Error.Brush}"
                               ToolTip.Tip="永久删除" AutomationProperties.Name="永久删除" />
            </Grid>
          </DataTemplate>
        </md:MdList.ItemTemplate>
      </md:MdList>
    </Grid>
  </Grid>
</UserControl>
