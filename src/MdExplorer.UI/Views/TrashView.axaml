<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:vm="using:MdExplorer.UI.ViewModels"
             x:Class="MdExplorer.UI.Views.TrashView"
             x:DataType="vm:ShellViewModel">
  <md:MdScrollViewer HorizontalScrollBarVisibility="Disabled" AllowMouseDrag="True">
    <StackPanel Margin="20,12,20,28" Spacing="16" MaxWidth="920" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="{Binding TrashTitle}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Capabilities.UsesAppTrash}"
                     Text="仅保留经 Eidoria 删除的项目，不是 Android 系统回收站" />
        </StackPanel>
        <md:MdButton Grid.Column="1" Variant="Outlined" VerticalAlignment="Center"
                     Command="{Binding EmptyTrashCommand}" IsVisible="{Binding HasTrashItems}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.Delete}" Size="18"
                       Foreground="{DynamicResource Md.Sys.Color.Error.Brush}" />
            <TextBlock Text="清空回收站" VerticalAlignment="Center"
                       Foreground="{DynamicResource Md.Sys.Color.Error.Brush}" />
          </StackPanel>
        </md:MdButton>
      </Grid>

      <Border Classes="card" IsVisible="{Binding Capabilities.CanBrowseTrash}">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="14" RowSpacing="12">
          <Border Width="44" Height="44" CornerRadius="14" VerticalAlignment="Center"
                  Background="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.Delete}" Size="23"
                       Foreground="{DynamicResource Md.Sys.Color.OnPrimaryContainer.Brush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="body" Text="{Binding TrashSummaryText}" />
            <TextBlock Classes="caption" IsVisible="{Binding HasTrashQuota}">
              <Run Text="上限 " /><Run Text="{Binding TrashQuotaText}" /><Run Text=" · " /><Run Text="{Binding TrashRetentionText}" />
            </TextBlock>
            <TextBlock Classes="caption" Text="系统回收站 · 由系统管理" IsVisible="{Binding !HasTrashQuota}" />
          </StackPanel>
          <md:MdLinearProgressIndicator Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                                        Value="{Binding TrashUsedPercent}" Height="6"
                                        IsVisible="{Binding HasTrashQuota}" />
        </Grid>
      </Border>

      <Border Classes="card" IsVisible="{Binding !Capabilities.CanBrowseTrash}">
        <StackPanel Spacing="6">
          <TextBlock Classes="body" Text="此平台暂不支持在此浏览回收站" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="删除仍会送至系统回收站；如需还原或清空，请使用系统文件管理器。" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowTrashEmpty}">
        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="16">
          <md:MdIcon Glyph="{x:Static md:MdSymbols.Delete}" Size="38" HorizontalAlignment="Center"
                     Foreground="{DynamicResource Md.Sys.Color.Primary.Brush}" />
          <TextBlock Classes="body" Text="回收站是空的" HorizontalAlignment="Center" />
          <TextBlock Classes="caption" Text="删除的项目会显示在这里" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding TrashItems}" IsVisible="{Binding Capabilities.CanBrowseTrash}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TrashItemModel">
            <Border Classes="card" Padding="14" Margin="0,0,0,10">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Border Width="44" Height="44" CornerRadius="14" VerticalAlignment="Center"
                        Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
                  <md:MdIcon Glyph="{Binding Glyph}" Size="23"
                             Foreground="{DynamicResource Md.Sys.Color.Primary.Brush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding MetaText}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding OriginalPath}" />
                </StackPanel>
                <md:MdButton Grid.Column="2" Variant="Tonal" VerticalAlignment="Center" Click="OnRestoreClick">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <md:MdIcon Glyph="{x:Static md:MdSymbols.Refresh}" Size="18" />
                    <TextBlock Text="还原" VerticalAlignment="Center" />
                  </StackPanel>
                </md:MdButton>
                <md:MdIconButton Grid.Column="3" Icon="{x:Static md:MdSymbols.Delete}" Click="OnDeleteClick"
                                 Foreground="{DynamicResource Md.Sys.Color.Error.Brush}" VerticalAlignment="Center"
                                 ToolTip.Tip="永久删除" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
