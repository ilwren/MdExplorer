<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="using:Md3.Avalonia.Controls">

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="SelectableTextBlock.body">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.tap-chip">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- 文件列表/网格容器：选中态以次容器色表达（MD3 列表选中语义） -->
  <Style Selector="ListBox.file-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.file-list ListBoxItem">
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.file-list ListBoxItem Border.file-row">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="ListBox.file-list ListBoxItem:selected Border.file-row">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" />
  </Style>
  <Style Selector="ListBox.file-grid ListBoxItem:selected Border.file-row">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" />
  </Style>

  <!-- 导航按钮（导轨/抽屉条目共用横向布局微调） -->
  <Style Selector="md|MdButton.nav-entry">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
</Styles>
