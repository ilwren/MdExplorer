<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="using:Md3.Avalonia.Controls">
  <Styles.Resources>
    <!-- Md3 未注册原生 ContextMenu 的无键 ControlTheme（MenuItem/Separator 已被 MdDesktopAdapters 覆盖），在此补齐 -->
    <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1"
                  CornerRadius="16" ClipToBounds="True" BoxShadow="0 10 30 #24000000">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="SelectableTextBlock.body">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- 通用表面：概念稿的关键不是更艳，而是底板、工作区与卡片之间有稳定的明暗阶梯。 -->
  <Style Selector="Border.workspace-surface">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Surface.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BoxShadow" Value="0 12 32 #17000000" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Surface.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="BoxShadow" Value="0 5 18 #12000000" />
  </Style>

  <Style Selector="Border.tap-chip">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Surface.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="13,10" />
    <Setter Property="BoxShadow" Value="0 3 12 #0D000000" />
  </Style>
  <Style Selector="Border.tap-chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" />
  </Style>

  <Style Selector="Border.category-card">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="BoxShadow" Value="0 4 14 #0D000000" />
  </Style>
  <Style Selector="Border.category-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}" />
  </Style>

  <Style Selector="Border.path-pill">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <Style Selector="DataGrid.file-details">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Surface.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="RowBackground" Value="{DynamicResource Md.Sys.Color.Surface.Brush}" />
  </Style>
  <Style Selector="DataGrid.file-details DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <Style Selector="DataGrid.file-details DataGridRow:selected DataGridCell">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
  </Style>

  <!-- 文件列表/网格容器：静止时轻、悬停时浮起、选中时同时给底色与描边。 -->
  <Style Selector="ListBox.file-list ListBoxItem">
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Margin" Value="2,1" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="ListBox.file-grid ListBoxItem">
    <Setter Property="CornerRadius" Value="19" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- MdList 生成容器的选中底色画在模板根 Border 上；直接给该部件圆角，避免选中态露出直角。 -->
  <Style Selector="ListBox.file-list ListBoxItem /template/ Border#PART_Container">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Margin" Value="2,0" />
  </Style>
  <Style Selector="ListBox.file-grid ListBoxItem /template/ Border#PART_Container">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Margin" Value="2" />
  </Style>
  <Style Selector="ListBox.file-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.file-list ListBoxItem">
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.file-grid ListBoxItem">
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="ListBox.file-list ListBoxItem Border.file-row">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.file-list ListBoxItem:pointerover Border.file-row">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" />
  </Style>
  <Style Selector="ListBox.file-list ListBoxItem:selected Border.file-row">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" />
  </Style>
  <Style Selector="ListBox.file-grid ListBoxItem Border.file-card">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Surface.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="19" />
    <Setter Property="BoxShadow" Value="0 4 15 #0D000000" />
  </Style>
  <Style Selector="ListBox.file-grid ListBoxItem:pointerover Border.file-card">
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" />
    <Setter Property="BoxShadow" Value="0 8 22 #17000000" />
  </Style>
  <Style Selector="ListBox.file-grid ListBoxItem:selected Border.file-card">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <!-- 桌面工具栏/面包屑不沿用整片品牌青：正文回到墨色，品牌色只留给主动作与状态。 -->
  <Style Selector="md|MdButton.toolbar-action">
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
  </Style>
  <Style Selector="md|MdButton.toolbar-action md|MdIcon">
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
  </Style>
  <Style Selector="md|MdButton.breadcrumb-segment">
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
  </Style>

  <!-- 导航按钮（导轨/抽屉条目共用横向布局微调） -->
  <Style Selector="md|MdButton.nav-entry">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="md|MdButton.nav-entry md|MdIcon">
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
  </Style>
  <Style Selector="md|MdButton.nav-entry.active">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
  </Style>
  <Style Selector="md|MdButton.nav-entry.active md|MdIcon">
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" />
  </Style>
</Styles>
