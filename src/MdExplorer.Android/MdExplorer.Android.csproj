<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>28</SupportedOSPlatformVersion>
    <ApplicationId>dev.mdexplorer.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.3.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RootNamespace>MdExplorer.Android</RootNamespace>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- Release 时由 CI 打开 Trimming + RunAOTCompilation（见 ci.yml android Job） -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <ProjectReference Include="..\MdExplorer.UI\MdExplorer.UI.csproj" />
  </ItemGroup>
</Project>
