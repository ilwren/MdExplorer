<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MdExplorer.Desktop.SearchIndexView">
  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource SurfaceBrush}">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="22,14">
      <Button Click="OnCloseClick" ToolTip.Tip="返回文件浏览" Padding="10"><TextBlock Text="←" FontSize="20"/></Button>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
        <TextBlock Text="搜索与索引中心" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="跨根目录搜索 · 规划预览" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
      </StackPanel>
      <Border Grid.Column="2" Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="14" Padding="12,7" VerticalAlignment="Center">
        <TextBlock Text="06  ·  概念预演" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceLowBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,1,0,1" Padding="22,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <TextBox x:Name="SearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="⌕  搜索文件名或正文…" Height="46" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Click="OnFileNameModeClick" Padding="13,8" Background="{DynamicResource SelectedBrush}">文件名</Button>
          <Button Click="OnContentModeClick" Padding="13,8">正文</Button>
          <Button IsEnabled="False" ToolTip.Tip="后续规划，不在当前范围">语义 · 后续</Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="SceneColumns" Grid.Row="2" ColumnDefinitions="230,*,310" Margin="18,16" ColumnSpacing="16">
      <!-- Search facets -->
      <Border x:Name="FilterPanel" Grid.Column="0" Background="{DynamicResource SurfaceLowBrush}" CornerRadius="20" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <StackPanel Spacing="8">
              <TextBlock Text="索引根" FontWeight="SemiBold" />
              <CheckBox Content="此电脑 · 用户目录" IsChecked="{Binding IncludeHome}" />
              <CheckBox Content="D: / 素材" IsChecked="{Binding IncludeDriveD}" />
              <CheckBox Content="移动磁盘 · 已离线" IsChecked="False" IsEnabled="False" />
              <Button Click="OnAddRootClick" HorizontalContentAlignment="Left" Padding="8,6">＋ 添加索引根</Button>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource OutlineBrush}" />
            <StackPanel Spacing="7">
              <TextBlock Text="文件类型" FontWeight="SemiBold" />
              <Button Click="OnAllTypesClick" HorizontalContentAlignment="Left" Padding="8,6">全部类型</Button>
              <Button Click="OnImagesClick" HorizontalContentAlignment="Left" Padding="8,6">图片</Button>
              <Button Click="OnDocumentsClick" HorizontalContentAlignment="Left" Padding="8,6">文档与文本</Button>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource OutlineBrush}" />
            <StackPanel Spacing="7">
              <TextBlock Text="修改时间" FontWeight="SemiBold" />
              <RadioButton Content="任意时间" GroupName="Modified" IsChecked="True" />
              <RadioButton Content="最近 7 天" GroupName="Modified" />
              <RadioButton Content="最近 30 天" GroupName="Modified" />
              <RadioButton Content="今年" GroupName="Modified" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Results -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="2,0,4,10">
          <StackPanel Spacing="3"><TextBlock Text="搜索结果" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ModeNote}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding ResultCount}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Results}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="17" Padding="14">
                  <Grid ColumnDefinitions="42,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="{Binding Glyph}" FontSize="25" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
                    <Button Grid.Column="2" Grid.RowSpan="2" Click="OnResultOpenClick" ToolTip.Tip="定位到文件" Tag="{Binding Path}" Padding="9"><TextBlock Text="↗"/></Button>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2" />
                    <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceLowBrush}" CornerRadius="9" Padding="9,6" Margin="0,6,0,0">
                      <TextBlock Text="{Binding Excerpt}" FontSize="11" TextWrapping="Wrap" MaxHeight="38" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- Index health + privacy actions -->
      <StackPanel x:Name="IndexPanel" Grid.Column="2" Spacing="12">
        <Border Background="{DynamicResource SurfaceLowBrush}" CornerRadius="20" Padding="18">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="索引健康" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="本地样例" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid>
            <Border Width="142" Height="142" CornerRadius="80" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="8" HorizontalAlignment="Center" Padding="14">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3"><TextBlock Text="{Binding IndexSizeText}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="索引体积" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
              <TextBlock Text="已索引条目" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding IndexedItemsText}" FontSize="12"/>
              <TextBlock Grid.Row="1" Text="最近更新" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Grid.Row="1" Grid.Column="1" Text="今天 09:41" FontSize="12"/>
              <TextBlock Grid.Row="2" Text="失效项目" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Grid.Row="2" Grid.Column="1" Text="12 项待复核" FontSize="12"/>
            </Grid>
            <TextBlock Text="{Binding IndexStateText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="20" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="本机隐私" FontWeight="SemiBold" />
            <TextBlock Text="索引数据仅保存在此设备。正文索引关闭时，不读取文件内容。清空索引不会删除原文件。" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            <CheckBox Content="允许建立正文索引（规划开关）" IsChecked="False" />
            <Button Click="OnPauseClick" HorizontalContentAlignment="Left" Padding="8,6">暂停 / 恢复维护</Button>
            <Button Click="OnRebuildClick" HorizontalContentAlignment="Left" Padding="8,6">重新建立索引</Button>
            <Button Click="OnClearClick" Foreground="{DynamicResource DangerBrush}" HorizontalContentAlignment="Left" Padding="8,6">清空本地索引…</Button>
            <Border Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="12" Padding="10,8"><TextBlock Text="{Binding StatusText}" FontSize="10" TextWrapping="Wrap"/></Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Inline safety confirmation; no real index data is touched in this preview. -->
    <Border x:Name="ClearConfirmLayer" Grid.RowSpan="3" Background="#66000000" IsVisible="{Binding IsClearConfirmationVisible}" Padding="18">
      <Border Width="440" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="24" Padding="22">
        <StackPanel Spacing="12"><TextBlock Text="清空本地索引？" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="这只会清除索引记录，不会删除任何原始文件。当前为概念预演，不会访问或修改真实索引。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Click="OnCancelClearClick">取消</Button><Button Click="OnConfirmClearClick" Background="{DynamicResource DangerBrush}">确认清空（演示）</Button></StackPanel></StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
