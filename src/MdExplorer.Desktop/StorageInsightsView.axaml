<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MdExplorer.Desktop.StorageInsightsView">
  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource SurfaceBrush}">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="22,14" ColumnSpacing="8">
      <Button Click="OnCloseClick" ToolTip.Tip="返回文件浏览" Padding="10"><TextBlock Text="←" FontSize="20"/></Button>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
        <TextBlock Text="存储洞察" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="空间地图 · 重复项复核 · 大文件" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
      </StackPanel>
      <Button Grid.Column="2" Click="OnSearchPreviewClick" ToolTip.Tip="前往 06 搜索与索引中心" Padding="9,7"><TextBlock Text="06 搜索与索引" FontSize="11"/></Button>
      <Border Grid.Column="3" Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="14" Padding="12,7" VerticalAlignment="Center">
        <TextBlock Text="08  ·  概念预演" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,Auto" Margin="18,0,18,14" ColumnSpacing="10">
      <Border Background="{DynamicResource SurfaceLowBrush}" CornerRadius="17" Padding="14"><StackPanel Spacing="3"><TextBlock Text="本机容量" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="800 GB" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Grid.Column="1" Background="{DynamicResource SurfaceLowBrush}" CornerRadius="17" Padding="14"><StackPanel Spacing="3"><TextBlock Text="已使用" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="544 GB · 68%" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Grid.Column="2" Background="{DynamicResource SurfaceLowBrush}" CornerRadius="17" Padding="14"><StackPanel Spacing="3"><TextBlock Text="可用空间" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="256 GB" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Grid.Column="3" Background="{DynamicResource SelectedBrush}" CornerRadius="17" Padding="14"><TextBlock Text="需人工复核 · 不会自动清理" FontSize="11" VerticalAlignment="Center"/></Border>
    </Grid>

    <Grid x:Name="InsightsColumns" Grid.Row="2" ColumnDefinitions="1.45*,*" Margin="18,0,18,18" ColumnSpacing="14">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Border Background="{DynamicResource SurfaceLowBrush}" CornerRadius="20" Padding="16">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="空间地图" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="面积代表占用体积；点击方块只定位，不删除" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SelectedCategory}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/></Grid>
              <Grid RowDefinitions="94,82" ColumnDefinitions="1.4*,*,.8*" RowSpacing="6" ColumnSpacing="6">
                <Button Grid.ColumnSpan="2" Click="OnTreemapImageClick" Background="#287B79" Foreground="White" CornerRadius="13" Padding="12" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"><StackPanel><TextBlock Text="图片与视频" FontWeight="SemiBold"/><TextBlock Text="214 GB" FontSize="11"/></StackPanel></Button>
                <Button Grid.Column="2" Click="OnTreemapDocumentsClick" Background="#5575A6" Foreground="White" CornerRadius="13" Padding="10" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"><StackPanel><TextBlock Text="文档" FontWeight="SemiBold"/><TextBlock Text="86 GB" FontSize="10"/></StackPanel></Button>
                <Button Grid.Row="1" Click="OnTreemapAppsClick" Background="#7A659B" Foreground="White" CornerRadius="13" Padding="12" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"><StackPanel><TextBlock Text="应用与缓存" FontWeight="SemiBold"/><TextBlock Text="128 GB" FontSize="11"/></StackPanel></Button>
                <Button Grid.Row="1" Grid.Column="1" Click="OnTreemapArchiveClick" Background="#AF8051" Foreground="White" CornerRadius="13" Padding="10" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"><StackPanel><TextBlock Text="压缩包" FontWeight="SemiBold"/><TextBlock Text="72 GB" FontSize="10"/></StackPanel></Button>
                <Button Grid.Row="1" Grid.Column="2" Click="OnTreemapOtherClick" Background="#687B6B" Foreground="White" CornerRadius="13" Padding="10" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"><StackPanel><TextBlock Text="其他" FontWeight="SemiBold"/><TextBlock Text="44 GB" FontSize="10"/></StackPanel></Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="112,*,Auto" ColumnSpacing="10"><TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Ratio}" Height="7" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/><TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="20" Padding="16">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="空间占用较大的项目" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="先定位或预览；删除留在文件上下文菜单中" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="Top 4" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid>
              <ItemsControl ItemsSource="{Binding LargeFiles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="32,*,Auto,Auto,Auto" Margin="5,7" ColumnSpacing="5"><TextBlock Text="▤" Foreground="{DynamicResource PrimaryBrush}" FontSize="18" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="3" Click="OnLocateClick" Tag="{Binding FileName}" Padding="8,5" ToolTip.Tip="定位">定位</Button><Button Grid.Column="4" Click="OnPreviewClick" Tag="{Binding FileName}" Padding="8,5" ToolTip.Tip="预览">预览</Button></Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="ReviewColumn" Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Border Background="{DynamicResource SurfaceLowBrush}" CornerRadius="20" Padding="16">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="重复文件组" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="候选需逐组复核；不会直接删除" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="12" Padding="9,5"><TextBlock Text="{Binding ReviewCountLabel}" FontSize="10"/></Border></Grid>
              <ItemsControl ItemsSource="{Binding Duplicates}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="9"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="15" Padding="12">
                      <StackPanel Spacing="8"><Grid ColumnDefinitions="40,*,Auto"><Border Width="36" Height="36" Background="{DynamicResource SelectedBrush}" CornerRadius="10"><TextBlock Text="▧" Foreground="{DynamicResource PrimaryBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0" Spacing="3"><TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Size}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel><Button Grid.Column="2" Click="OnReviewClick" Tag="{Binding}" Padding="8,5" ToolTip.Tip="加入人工复核"><TextBlock Text="＋"/></Button></Grid><TextBlock Text="{Binding Locations}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Click="OnReviewAllClick" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" HorizontalContentAlignment="Center">加入复核列表</Button>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="20" Padding="16">
            <StackPanel Spacing="9"><TextBlock Text="安全边界" FontWeight="SemiBold"/><TextBlock Text="此页面只做空间定位与人工复核，不会自动清理或永久删除。加入复核后，仍须在文件操作任务中确认。" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><Border Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="11" Padding="10,8"><TextBlock Text="{Binding StatusText}" FontSize="10" TextWrapping="Wrap"/></Border></StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
