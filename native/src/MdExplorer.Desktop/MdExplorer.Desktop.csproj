<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop host (Win/Linux by RID) — composition root only — §4.1 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MdExplorer</AssemblyName>
  </PropertyGroup>
  <!-- 反射绑定所需元数据在 AOT 下必须显式保留，否则绑定静默失效（见 ILLink.Descriptors.xml） -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MdExplorer.UI/MdExplorer.UI.csproj" />
    <ProjectReference Include="../MdExplorer.Application/MdExplorer.Application.csproj" />
    <ProjectReference Include="../MdExplorer.Infrastructure/MdExplorer.Infrastructure.csproj" />
    <ProjectReference Include="../MdExplorer.Platform.Windows/MdExplorer.Platform.Windows.csproj" />
    <ProjectReference Include="../MdExplorer.Platform.Linux/MdExplorer.Platform.Linux.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
