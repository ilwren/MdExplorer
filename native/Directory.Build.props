<Project>
  <!-- MdExplorer build-wide properties (DEVELOPMENT.md §4.2 / §11.2) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <!-- P2: AOT first. All projects are trim/AOT friendly unless they host. -->
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Architecture rules are enforced by tests/ArchitectureChecks, not warnings. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
